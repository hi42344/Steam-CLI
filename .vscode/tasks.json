{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "steam-cli",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-O3",
                "-static",
                "-s",
                "src/*.cpp",
                "-Isrc",
                "-o",
                "${workspaceFolder}/build/steam.exe",
                "-lshell32",
                "-lwininet"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}